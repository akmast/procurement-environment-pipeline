# Copy this file to .env (already gitignored — see root .gitignore's
# unanchored `.env` rule) and fill in your own values. Never commit real
# AWS credentials: this setup deliberately never uses static
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY anywhere — Metabase reads your
# existing local AWS CLI/SSO profile instead (see README.md).

# Name of your local AWS CLI/SSO profile (see `aws configure list-profiles`)
# that has — or that you've granted, see iam-policy.json — permission to
# query the Gold Layer via Athena/Glue. Required, no default.
AWS_PROFILE=your-profile-name

# AWS region the pipeline's Athena workgroup / Glue Catalog run in.
AWS_REGION=eu-central-1

# Only needed if your AWS config/credentials live somewhere other than
# the default ~/.aws (e.g. a custom AWS_SHARED_CREDENTIALS_FILE
# location, or a non-standard $HOME on Windows). Leave commented out to
# use ~/.aws.
# AWS_CONFIG_HOME=/custom/path/to/.aws
